{
  "name": "gvboard-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "admin",
    "user"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w admin",
    "dev:user": "npm run dev -w user",
    "typecheck": "npm run typecheck -w admin && npm run typecheck -w user",
    "build": "npm run build -w admin && npm run build -w user",
    "build:admin": "npm run build -w admin",
    "build:user": "npm run build -w user",
    "check:fingerprint": "node scripts/check-fingerprint.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vue-tsc": "^3.1.3"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "naive-ui": "^2.45.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3"
  }
}
