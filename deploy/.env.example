# 复制为 .env 后修改。密码请使用足够长的随机字符串。
TZ=Asia/Shanghai
HTTP_PORT=8080

DB_NAME=gvboard
DB_USER=gvboard
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=

# 构建镜像时使用的依赖源（国内网络可改为 https://goproxy.cn,direct 与 https://registry.npmmirror.com）
GOPROXY=https://proxy.golang.org,direct
NPM_REGISTRY=https://registry.npmjs.org
